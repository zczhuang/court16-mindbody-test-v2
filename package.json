{
  "name": "court16-mindbody-test",
  "version": "0.1.0",
  "private": true,
  "description": "Court 16 — MindBody write happy-path test. De-risks the BLINK failure mode before Phase 3.",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:trial-intake": "node --no-warnings --experimental-strip-types scripts/test-trial-intake.ts",
    "test:trial-reporting": "node --no-warnings --experimental-strip-types scripts/test-trial-reporting.ts",
    "test:hubspot-config": "node --no-warnings --experimental-strip-types scripts/test-hubspot-config.ts",
    "test:hubspot-deal-ledger": "node --no-warnings --experimental-strip-types scripts/test-hubspot-deal-ledger.ts",
    "test:distributed-action-lock": "node --no-warnings --experimental-strip-types scripts/test-distributed-action-lock.ts",
    "test:mindbody-booking-evidence": "node --no-warnings --experimental-strip-types scripts/test-mindbody-booking-evidence.ts",
    "test:kids-trial-readiness": "node --no-warnings --experimental-strip-types scripts/test-kids-trial-readiness.ts",
    "test:kids-calendar": "node --no-warnings --experimental-strip-types scripts/test-kids-calendar.ts",
    "test:mindbody-pagination": "node --no-warnings --experimental-strip-types scripts/test-mindbody-pagination.ts",
    "test:mindbody-write-guard": "node --no-warnings --experimental-strip-types scripts/test-mindbody-write-guard.ts",
    "validate:trial-config": "node --no-warnings --experimental-strip-types scripts/validate-trial-config.ts",
    "audit:mindbody-sites": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/audit-mindbody-sites.ts",
    "hubspot:deal-ledger-schema": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/sync-hubspot-deal-ledger-schema.ts",
    "hubspot:deal-ledger-schema:verify": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/sync-hubspot-deal-ledger-schema.ts --verify"
  },
  "dependencies": {
    "@vercel/functions": "^3.6.1",
    "google-auth-library": "^10.6.2",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.0"
  }
}
