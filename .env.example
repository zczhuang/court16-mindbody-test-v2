# ─────────────────────────────────────────────────────────────────────────────
# MindBody Public API v6 — sandbox credentials
# ─────────────────────────────────────────────────────────────────────────────
# To run this test you need THREE things:
#   1. An Api-Key (from developers.mindbodyonline.com — free developer account)
#   2. A Site ID (for the sandbox, use -99)
#   3. Staff credentials that can issue a StaffUserToken
#
# The "-99" public sandbox accepts well-known staff credentials:
#   Username: Siteowner       Password: apitest1234
# (This is the form documented by MindBody for the -99 sandbox.)
#
# Stuart also received a sandbox login framed as:
#   Username: mindbodysandboxsite@gmail.com   Password: Apitest1234
# If one doesn't work, try the other — they're the same sandbox, different
# credential conventions.
# ─────────────────────────────────────────────────────────────────────────────

MINDBODY_API_KEY=paste-your-api-key-here
MINDBODY_SITE_ID=-99
MINDBODY_STAFF_USERNAME=Siteowner
MINDBODY_STAFF_PASSWORD=apitest1234

# Base URL — don't change unless MindBody moves their endpoint.
MINDBODY_BASE_URL=https://api.mindbodyonline.com/public/v6

# ─────────────────────────────────────────────────────────────────────────────
# MindBody OAuth 2.0 — consumer login at signin.mindbodyonline.com
# ─────────────────────────────────────────────────────────────────────────────
# Register an OAuth client at developers.mindbodyonline.com under your
# subscriber. Redirect URI MUST match exactly what you register (scheme +
# path, no trailing slash variation).
#
# Local dev:    http://localhost:3000/auth/mindbody/callback
# Production:   https://<your-vercel-domain>/auth/mindbody/callback
#
# Scopes used by this app:
#   openid email profile offline_access
#   subscriber:read class:read enrollment:read client:read client:write
MINDBODY_CLIENT_ID=
MINDBODY_CLIENT_SECRET=
MINDBODY_REDIRECT_URI=http://localhost:3000/auth/mindbody/callback

# Symmetric key for AES-256-GCM session cookies. Generate with:
#   openssl rand -hex 32
# Must be at least 32 chars. Rotate to invalidate all sessions.
SESSION_SECRET=

# ENDPOINT-SPECIFIC TEST FLAG — this is NOT a global write kill switch.
# Values:
#   test   → sends Test=true only to endpoints that accept it. Consumer-mode
#            AddClient/AddClientToClass omit Test and persist on real sites.
#   live   → supported endpoints receive Test=false; all writes persist.
# Use Site -99 for non-persistent testing. Real-site fixtures need explicit
# approval, a unique test email, and a Mindbody UI cleanup owner.
MINDBODY_WRITE_MODE=test

# Dev escape hatch: force /api/mindbody/calendar to query MINDBODY_SITE_ID
# (e.g. -99 sandbox) regardless of the user's location selection. Use this
# until Anthony authorizes the dev Api-Key against the 6 production Site IDs.
MINDBODY_USE_SANDBOX_FALLBACK=false

# Public kids-trial release gate. This NEXT_PUBLIC value is compiled into the
# client and must stay false until every per-club evidence flag in
# config/locations.ts is true and the launch owner approves release.
NEXT_PUBLIC_KIDS_TRIAL_PUBLIC_LAUNCH_ENABLED=false

# Set true only after scripts/sync-hubspot-deal-ledger-schema.ts --apply has
# succeeded in the intended portal and the subsequent read-only verification
# reports no missing or mismatched Deal properties.
# Server-only. Enable only after the Deal schema verifies and the club's
# hubspotDealLedgerVerified launch evidence is true.
HUBSPOT_DEAL_LEDGER_ENABLED=false
# Default-off escape hatch for explicitly migrated historical requests only.
# Never enable as a substitute for Deal-ledger migration.
HUBSPOT_LEGACY_CONTACT_BOOKING_FALLBACK_ENABLED=false
# The schema script refuses --apply unless this one-run approval is true.
HUBSPOT_DEAL_SCHEMA_APPLY=false

# Server-only cross-instance mutation lock. Runtime routes fail closed before
# HubSpot/Mindbody writes when either value is missing or Redis is unavailable.
# Provision a dedicated Upstash Redis database and copy its REST credentials.
# Lock scopes are SHA-256 hashed before they are sent; raw emails are not keys.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only irreversible-write gate. BOTH values are required for a real
# Court 16 site; an approved Site ID must appear in the comma-separated list.
# These are intentionally not auto-synced by scripts/deploy.sh.
MINDBODY_REAL_WRITES_ENABLED=false
MINDBODY_REAL_WRITE_SITE_IDS=

# Optional: v5 SOAP fallback for the /admin/trial-v5 test page only.
# Separate credential from the v6 Api-Key — retrieved from
# developers.mindbodyonline.com → Sources → CedarWindSolutionsLLC → Source Password.
# When unset, the v5 test page shows "v5 unavailable"; nothing else is affected.
MINDBODY_SOURCE_PASSWORD=

# Optional: if set, API routes require this bearer token. Leave blank for open sandbox testing.
TEST_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Protected trial E2E acceptance lane — Preview/local only
# ─────────────────────────────────────────────────────────────────────────────
# The /e2e/trial page and /api/e2e/* routes return 404 unless all gates pass.
# They are always forbidden when VERCEL_ENV=production. Keep HUBSPOT_ACCESS_TOKEN
# unset in this deployment; the policy refuses to start if one is present.
TRIAL_E2E_ENABLED=false
TRIAL_E2E_BACKEND=fixture
# Required only for local `next dev`; hosted runs require VERCEL_ENV=preview.
TRIAL_E2E_LOCAL_ENABLED=false
# Stable identifier for this isolated lane. Receipts and sessions are bound to it.
TRIAL_E2E_AUDIENCE=court16-trial-e2e-preview
TRIAL_E2E_ACCESS_TOKEN=
# Separate from STAFF_CONFIRM_SIGNING_SECRET. Generate with: openssl rand -hex 32
TRIAL_E2E_SIGNING_SECRET=

# Optional real Mindbody public-sandbox backend. Requires all of the normal
# Mindbody credentials above, MINDBODY_SITE_ID=-99, and this second write gate.
# It dynamically discovers Site -99 / Program 26 / Schedule 2180, accepts only
# @court16-test.invalid clients whose six communication flags read back false,
# and uses Location 1 + $0 Service 1377. Never enable on Production.
TRIAL_E2E_MINDBODY_WRITES_ENABLED=false
# Dedicated E2E-only Redis. Never reuse production UPSTASH_REDIS_REST_* here.
# Sandbox writes remain disabled unless this store is present. It serializes
# each run and stores a signed CAS write-ahead journal plus the latest receipt;
# ambiguous started mutations are reconciled read-only and never auto-repeated.
E2E_UPSTASH_REDIS_REST_URL=
E2E_UPSTASH_REDIS_REST_TOKEN=

# Optional: seed email used by the happy-path endpoint when none is supplied.
# Uses a plus-address so you can keep using the same inbox for repeated runs.
HAPPY_PATH_DEFAULT_EMAIL=stuart+mbtest@cedarwind.io

# ─────────────────────────────────────────────────────────────────────────────
# HubSpot Private App — Track 1 owns CRM + every email via Workflows
# ─────────────────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot (Settings → Integrations → Private Apps)
# with the scopes listed in docs/hubspot-schema.md. Paste the access token
# below. The kids-trial and staff routes fail closed before Mindbody writes
# when HubSpot is unavailable; the Deal ledger is a required safety boundary.
HUBSPOT_ACCESS_TOKEN=

# Legacy metadata only: current HubSpot client code does not read HUBSPOT_ENV.
# It is not an isolation boundary; the access token determines the portal.
HUBSPOT_ENV=sandbox

# HubSpot portal ID (owned by Ibtissam). Stays constant.
HUBSPOT_PORTAL_ID=4832170

# Existing kids-trial form GUID at share.hsforms.com/1PpZqxIcuSeybkx8RT6bTmw2vkiy.
# Retained only for deliberate legacy compatibility. The booking app already
# upserts the Contact and creates its own Deal; submitting this form also fires
# the old 11-step account guide and legacy Deal-creation workflows.
HUBSPOT_TRIAL_FORM_GUID=3e966ac4-872e-49ec-9b93-1f114fa6d39b

# Keep false for the new booking flow. Set true only when intentionally testing
# the legacy form-triggered automation and accepting its duplicate side effects.
HUBSPOT_SUBMIT_LEGACY_TRIAL_FORM=false

# Optional overrides — only set if hitting HubSpot EU or a test host.
# HUBSPOT_API_BASE_URL=https://api.hubapi.com
# HUBSPOT_FORMS_BASE_URL=https://api.hsforms.com

# Optional — set to "true" to refuse to boot if HUBSPOT_ACCESS_TOKEN or
# HUBSPOT_PORTAL_ID is missing (and require the form GUID when legacy form
# submission is explicitly enabled). Useful in staging/prod.
HUBSPOT_REQUIRED=

# ─────────────────────────────────────────────────────────────────────────────
# Signed-token infrastructure for staff confirm/reassign/admin-retry URLs
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# MUST be >= 32 chars. Rotate on suspected exposure.
STAFF_CONFIRM_SIGNING_SECRET=

# Lifetime of staff confirm/deny/reassign links, in hours. Default 72 so a
# Friday-evening request's links survive the weekend before staff acts.
STAFF_TOKEN_TTL_HOURS=72

# Fully-qualified base URL used when stamping signed URLs into email bodies.
# Local dev: http://localhost:3000
# Production: https://app.court16.com (or whatever the Vercel alias is)
APP_BASE_URL=http://localhost:3000

# Reserved for a future application-owned notifier. Currently unused: staff
# recipients are configured inside the reviewed HubSpot workflows.
STAFF_NOTIFY_EMAIL=

# Optional Slack webhook for booking-failed alerts. Leave blank to disable.
SLACK_ALERT_WEBHOOK=

# How far ahead parents can request a kid trial, in days (default 7).
# Ibtissam (Trial Process Review, Jun 11 2026). NEXT_PUBLIC_ because the
# client-side calendar reads it too; the calendar API clamp is the authority.
NEXT_PUBLIC_TRIAL_MAX_ADVANCE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Phase 2 client tracker (/tracker.html) comment store
# ─────────────────────────────────────────────────────────────────────────────
# Comments from the Phase 2 tracker are stored as GitHub Issues in a private
# repo. Stuart gets email notifications via GitHub's native watch behavior
# (default on repos you own). Create a fine-grained PAT with Issues: Read+Write
# scoped to just zczhuang/court16-tracker-comments.
#
# Leave unset to disable the comment thread (the tracker still renders; the
# thread panel shows "not yet configured").
TRACKER_GITHUB_TOKEN=
TRACKER_REPO_OWNER=zczhuang
TRACKER_REPO_NAME=court16-tracker-comments
TRACKER_LABEL=tracker-feedback
